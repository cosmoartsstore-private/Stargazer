{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "sql:allow-load",
      "allow": [{ "db": "sqlite:*" }]
    },
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
